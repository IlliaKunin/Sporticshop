# Copy to .env.local and fill in. NEVER commit real values.

# Public address of the site, no trailing slash
SITE_URL=http://localhost:3000

# Random 32+ character secret used to sign admin sessions.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Admin login. Create the hash with:  npm run admin:hash -- "your long password"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=

# Database. Leave empty for a local file database (development only).
# Production: the Neon (or any Postgres) connection string.
DATABASE_URL=

# Payments. "stripe" in production. "fake" works ONLY in development (no real money).
PAYMENTS_MODE=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Photo storage. "local" = ./uploads (development). "s3" = Cloudflare R2 / any S3-compatible bucket.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket, e.g. https://img.example.com
S3_PUBLIC_URL=

# Optional: Telegram notification about new paid orders
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secret for the cleanup endpoint (releases expired reservations). Call it every 10 min from a cron.
CRON_SECRET=
